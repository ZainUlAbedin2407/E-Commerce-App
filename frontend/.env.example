# AI Communication — environment variables (Phase 2)
# Copy to .env.local for local work, or set the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# NEVER commit .env.local or any real secret. .env* is gitignored.

# MongoDB Atlas — free M0 cluster. Create it at cloud.mongodb.com,
# Database Access → add a user, Network Access → allow 0.0.0.0/0 (Vercel
# has no fixed IP), then Connect → Drivers → copy the connection string.
# Replace <db_password> with that user's password. 512 MB free.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/ai-communication?retryWrites=true&w=majority

# JWT secret for the httpOnly login cookie. Generate one locally with:
#   openssl rand -base64 32
# and paste the output here. Never reuse a password, never share it.
JWT_SECRET=

# Cloudinary — free tier, for admin product photo uploads.
# Create an account at cloudinary.com → Dashboard shows cloud name,
# API key and API secret (click the eye icon to reveal the secret).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public site URL (used for absolute links in emails/messages later).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
